{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mulu",
  "version": "0.2.1",
  "identifier": "io.github.miguelbconde.mulu",
  "build": {
    "frontendDist": "../../ui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Mulu",
        "width": 1100,
        "height": 720,
        "minWidth": 720,
        "minHeight": 480,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg"],
    "publisher": "Mulu contributors",
    "copyright": "Mulu contributors, GPL-3.0-or-later",
    "category": "Productivity",
    "shortDescription": "Open-source digital librarian",
    "longDescription": "Mulu finds, indexes and searches personal libraries of books and texts, entirely offline.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "PortugueseBR", "Spanish"],
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
